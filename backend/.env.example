# Claude (Anthropic API) - get a key at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: override the model (default claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional tuning: per-call output limit, max parallel Claude calls, SDK retries
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_MAX_CONCURRENCY=4
ANTHROPIC_MAX_RETRIES=3

# Postgres + pgvector. The +psycopg driver prefix is required.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/autoclaims

# Optional: semantic guideline search fallback (needs requirements-ml.txt)
ENABLE_SEMANTIC_SEARCH=false

# Optional: shared secret required (as X-Reviewer-Key) to submit overrides.
# Leave empty for local demos; set it anywhere other people can reach the app.
REVIEWER_API_KEY=

# Max requests per /api/batch call
MAX_BATCH_SIZE=50

# Comma-separated extra CORS origins (localhost:3000 is always allowed)
CORS_ORIGINS=
